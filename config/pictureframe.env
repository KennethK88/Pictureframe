#!/bin/bash

PICTUREFRAME_HOME="$HOME/pictureframe"
MEDIA_DIR="$PICTUREFRAME_HOME/media"
PLAYLIST_DIR="$PICTUREFRAME_HOME/playlists"
LOG_DIR="$PICTUREFRAME_HOME/logs"
CACHE_DIR="$PICTUREFRAME_HOME/cache/optimized"
IMAGE_CACHE_DIR="$PICTUREFRAME_HOME/cache/images"
CHANGED_MEDIA_FILE="$PICTUREFRAME_HOME/cache/changed-media.txt"

ONEDRIVE_REMOTE="onedrive:Bilderrahmen"
PLAYLIST_FILE="$PLAYLIST_DIR/media.m3u"
MPV_IMAGE_DURATION_SECONDS=20
HIGH_RES_IMAGE_PIXEL_THRESHOLD=20000000
MPV_AUDIO_DEVICE="alsa/hdmi:CARD=vc4hdmi,DEV=0"

BACKGROUND_AUDIO_FILE="$PICTUREFRAME_HOME/audio/background.mp3"
BACKGROUND_AUDIO_ENABLED_DEFAULT=true