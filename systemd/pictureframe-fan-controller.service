[Unit]
Description=Pictureframe Fan Controller

[Service]
Type=simple
User=kenneth
Environment=HOME=/home/kenneth
WorkingDirectory=/home/kenneth/pictureframe
ExecStart=/home/kenneth/pictureframe/fan-controller/build/pictureframe-fan-controller
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target