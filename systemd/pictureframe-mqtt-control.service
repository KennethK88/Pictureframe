[Unit]
Description=Pictureframe MQTT Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/home/@PI_USER@
Environment=PI_USER=@PI_USER@
ExecStart=@PI_TARGET_DIR@/scripts/mqtt-control.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
