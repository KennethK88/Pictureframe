[Unit]
Description=Pictureframe Playback
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=@PI_USER@
Environment=HOME=/home/@PI_USER@
WorkingDirectory=@PI_TARGET_DIR@
ExecStart=@PI_TARGET_DIR@/scripts/run-playback.sh
ExecStopPost=-@PI_TARGET_DIR@/scripts/background-audio-control.sh idle
Restart=on-failure
RestartSec=5
SuccessExitStatus=4

[Install]
WantedBy=multi-user.target